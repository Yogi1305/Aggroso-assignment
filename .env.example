# ============================================
# Expense Claim Policy Review Assistant
# Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real credentials.

# --- Database Configuration ---
# SQLite (default for local development):
DATABASE_URL=sqlite:///./expense_claims.db

# PostgreSQL via Supabase (production):
# DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Application Settings ---
APP_NAME=Expense Claim Policy Review Assistant API

# --- Authentication ---
# Change this to a strong random string in production
SECRET_KEY=your-super-secret-key-change-in-production

# --- LLM / AI Integration (Groq - OpenAI Compatible) ---
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=gsk_your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
